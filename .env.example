# Local-only demo configuration. Do not commit real credentials.
DEMO_DATABASE_URL=sqlite:///./data/demo.db
AI_API_BASE_URL=http://localhost:8000
DEMO_CORE_API_BASE_URL=http://localhost:8001
# Public mode only loads fictional fixtures and refuses real integration secrets.
COPILOT_PUBLIC_MOCK_ENABLED=true

# Auto uses the LLM when a key is configured and a deterministic fallback otherwise.
AI_MODE=auto
BUSINESS_TIMEZONE=Asia/Shanghai
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=10
KNOWLEDGE_BASE_PATH=./knowledge-base
# OpenAI Responses API planning and grounded answer generation:
# OPENAI_API_KEY=
# Optional endpoint compatible with the OpenAI Responses API.
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-5.6-terra
# Optional model tiering; each falls back to OPENAI_MODEL when unset.
# OPENAI_PLANNER_MODEL=
# OPENAI_COMPOSER_MODEL=
# DashScope example:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-flash
# OPENAI_PLANNER_MODEL=qwen3.5-plus
# OPENAI_COMPOSER_MODEL=qwen-flash
