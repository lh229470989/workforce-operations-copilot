{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.acmeworks.example/integrations/v1/confirmed-event.schema.json",
  "title": "AcmeWorks confirmed time-entry event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "request_id",
    "result"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_type": { "const": "time_entry.confirmed" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_entry_id",
        "person_display_name",
        "project_display_name",
        "work_date",
        "hours",
        "status"
      ],
      "properties": {
        "time_entry_id": { "type": "integer", "minimum": 1 },
        "person_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "project_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "work_date": { "type": "string", "format": "date" },
        "hours": {
          "type": "string",
          "pattern": "^(?:0\\.(?:25|50|75)|(?:[1-9]|1[0-9]|2[0-3])\\.(?:00|25|50|75)|24\\.00)$"
        },
        "status": {
          "enum": ["draft", "submitted", "approved", "rejected"]
        }
      }
    }
  }
}
