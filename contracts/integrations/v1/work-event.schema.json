{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.acmeworks.example/integrations/v1/work-event.schema.json",
  "title": "AcmeWorks WorkEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "source_account_ref",
    "calendar_id",
    "event_id",
    "event_updated_at",
    "person_ref",
    "project_code",
    "work_date",
    "duration_minutes",
    "description"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "const": "google_calendar" },
    "source_account_ref": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "calendar_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "event_updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "person_ref": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "project_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{2,32}$"
    },
    "work_date": {
      "type": "string",
      "format": "date"
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 1440,
      "multipleOf": 15
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!.*<[^>]*>)(?!.*\\b(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Cc][Ll][Ii][Ee][Nn][Tt][_-]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn])\\b)[^\\u0000-\\u001F\\u007F]*$"
    }
  }
}
